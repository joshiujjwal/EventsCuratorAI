# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/events_curator_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/events_curator_test
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=sk-...

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.eventscuratorai.com

# Event Source APIs
EVENTBRITE_API_KEY=
MEETUP_API_KEY=

# Optional tuning (defaults shown)
PORT=3001
NODE_ENV=development
CURATION_CACHE_TTL_SECONDS=14400
CURATION_MAX_CANDIDATES=50
CURATION_TOKEN_BUDGET=4000
INGESTION_INTERVAL_HOURS=6

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
